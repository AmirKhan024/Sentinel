# Sentinel configuration.
#
# Copy to `.env` and edit as needed. Every value below has a working default
# in src/sentinel/config.py, so an empty .env is a valid configuration.
#
# NOTE: The Chicago Data Portal food inspections endpoint requires NO
# authentication. This was verified against the live API. Do not invent
# credentials for it.

# --- Socrata / Chicago Data Portal --------------------------------------
SENTINEL_SOCRATA_DOMAIN=data.cityofchicago.org
SENTINEL_DATASET_ID=4ijn-s7e5

# Optional. A Socrata application token does NOT grant extra data access; it
# only moves you out of the shared anonymous throttling pool. Leave unset
# unless you start hitting HTTP 429.
# SENTINEL_SOCRATA_APP_TOKEN=

# --- Paths ---------------------------------------------------------------
# Root of the raw/interim/processed data layers. Relative to the repo root.
SENTINEL_DATA_DIR=data

# --- Ingestion behaviour -------------------------------------------------
# Rows requested per API page ($limit). Verified: the endpoint served 60000
# rows in a single response, so 50000 is a comfortable default.
SENTINEL_PAGE_SIZE=50000

# Default row cap used by `sentinel ingest --dev`.
SENTINEL_DEV_ROW_LIMIT=5000

# Per-request timeout in seconds.
SENTINEL_REQUEST_TIMEOUT=60.0

# Bounded retries for transient failures (429, 5xx, timeouts, transport
# errors). 4xx other than 429 is never retried.
SENTINEL_MAX_RETRIES=3

# Base seconds for exponential backoff between retries.
SENTINEL_RETRY_BACKOFF=1.0

# This endpoint drops its 5 `:@computed_region_*` columns (Socrata-generated
# ward / community area / census tract / zip spatial joins) whenever $order is
# present, unless they are explicitly selected. When true, ingestion discovers
# the full field list first and selects it explicitly: one extra request, a
# complete raw layer. See docs/api/socrata_findings.md section 6.
SENTINEL_INCLUDE_COMPUTED_REGIONS=true

# --- Logging -------------------------------------------------------------
SENTINEL_LOG_LEVEL=INFO
